{
  "name": "@quicklogo/api",
  "type": "module",
  "exports": {
    "./route-types": "./src/route-types.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --config ../worker/wrangler.jsonc",
    "dev:api": "wrangler dev",
    "deploy": "wrangler deploy --minify --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply quicklogo-db --local --config wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply quicklogo-db --remote --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@dodopayments/hono": "^0.2.5",
    "@hono/zod-validator": "^0.7.6",
    "@paralleldrive/cuid2": "catalog:",
    "@quicklogo/ai-providers": "workspace:*",
    "@quicklogo/auth": "workspace:*",
    "@quicklogo/db": "workspace:*",
    "@quicklogo/server-telemetry": "workspace:*",
    "@quicklogo/shared": "workspace:*",
    "@quicklogo/storage": "workspace:*",
    "dodopayments": "^2.32.0",
    "fast-deep-equal": "^3.1.3",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@quicklogo/eslint-config": "workspace:*",
    "@types/node": "^25.3.5",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
