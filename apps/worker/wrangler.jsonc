{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker",
  "main": "src/index.ts",
  "dev": {
    "port": 8788,
  },
  "compatibility_date": "2026-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quicklogo-db",
      "database_id": "20f887cb-35bc-45e6-a65a-1335facefa7e",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "image-generation",
        // Brand-kit jobs wait on several external image generations. Keep one
        // message per invocation so a batch cannot exceed Queues' 15m wall time.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "image-generation-dlq",
      },
      {
        "queue": "image-generation-dlq",
        "max_batch_size": 10,
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
